# Frontend API URL
VITE_API_URL=http://localhost:4000

# Backend & Database Configuration (Neon PostgreSQL)
PORT=4000
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
DATABASE_SSL=true

# Security & CORS
